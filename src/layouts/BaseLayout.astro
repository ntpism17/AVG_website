---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import { type Locale } from '../lib/i18n/locales';
import { alternateHrefs, stripLocaleFromPath } from '../lib/i18n/url';
import { localBusinessSchema } from '../lib/schema';
import { SITE, TITLE_SUFFIX } from '../lib/site';

interface Props {
  /** Page title. The company suffix is appended automatically. */
  title: string;
  description: string;
  /**
   * Use the title verbatim, without appending the company suffix. For pages
   * whose title is deliberately keyword-first (the homepage).
   */
  exactTitle?: boolean;
  ogType?: 'website' | 'article' | 'product';
  ogImage?: ImageMetadata | string;
  noindex?: boolean;
}

const {
  title,
  description,
  exactTitle = false,
  ogType = 'website',
  ogImage,
  noindex = false,
} = Astro.props;

const locale = (Astro.currentLocale ?? 'th') as Locale;
const pageTitle = exactTitle ? title : `${title}${TITLE_SUFFIX}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageSrc = typeof ogImage === 'string' ? ogImage : ogImage?.src;
const ogImageURL = new URL(ogImageSrc ?? '/og-image.png', Astro.site);

const alternates = alternateHrefs(stripLocaleFromPath(Astro.url.pathname));
const HREFLANG: Record<Locale, string> = { th: 'th', en: 'en', zh: 'zh-Hans' };
const OG_LOCALE: Record<Locale, string> = { th: 'th_TH', en: 'en_US', zh: 'zh_CN' };

// Emitted on every page so the business details are always discoverable.
const businessSchema = localBusinessSchema(Astro.site);
---

<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalURL} />

    {
      Object.entries(alternates).map(([l, href]) => (
        <link rel="alternate" hreflang={HREFLANG[l as Locale]} href={new URL(href, Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.th, Astro.site)} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    <meta property="og:site_name" content={SITE.name.en} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#b91c1c" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(businessSchema)} />

    <slot name="head" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
