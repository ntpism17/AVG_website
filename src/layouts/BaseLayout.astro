---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import { localBusinessSchema } from '../lib/schema';
import { SITE, TITLE_SUFFIX } from '../lib/site';

interface Props {
  /** Page title. The company suffix is appended automatically. */
  title: string;
  description: string;
  /**
   * Use the title verbatim, without appending the company suffix. For pages
   * whose title is deliberately keyword-first (the homepage).
   */
  exactTitle?: boolean;
  ogType?: 'website' | 'article' | 'product';
  ogImage?: ImageMetadata | string;
  noindex?: boolean;
}

const {
  title,
  description,
  exactTitle = false,
  ogType = 'website',
  ogImage,
  noindex = false,
} = Astro.props;

const pageTitle = exactTitle ? title : `${title}${TITLE_SUFFIX}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageSrc = typeof ogImage === 'string' ? ogImage : ogImage?.src;
const ogImageURL = new URL(ogImageSrc ?? '/og-image.png', Astro.site);

// Emitted on every page so the business details are always discoverable.
const businessSchema = localBusinessSchema(Astro.site);
---

<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:site_name" content={SITE.name.en} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(businessSchema)} />

    <slot name="head" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
