---
import HeroMeter from '../components/illustrations/HeroMeter.astro';
import ProductCard from '../components/ProductCard.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import CTABand from '../components/ui/CTABand.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFeaturedProducts } from '../lib/collections';
import { SERVICES } from '../lib/services';
import { SITE } from '../lib/site';

const products = await getFeaturedProducts();

// Brands we distribute, per CLAUDE.md.
const brands = ['CEWE', 'SECURE', 'EDMI'];
---

<BaseLayout
  title="Energy Meter, Power Quality Meter | Advanced Grid Co., Ltd."
  exactTitle
  description="บริษัท แอดวานซ์ กริด จำกัด ผู้แทนจำหน่าย ให้คำปรึกษา ออกแบบและติดตั้งระบบสื่อสารทางไฟฟ้าสำหรับ Energy Meter, Power Quality Meter (PQM) และอุปกรณ์สื่อสาร TOU Meters & Power Quality Analyzer สำหรับงานโครงการโรงไฟฟ้า โซลาร์ รูฟท็อป และโซลาร์ฟาร์มลอยน้ำ"
>
  <!-- Hero -->
  <Section width="wide" spacing="lg" innerClass="grid lg:grid-cols-2 gap-12 items-center">
    <div>
      <Eyebrow>ผู้เชี่ยวชาญด้านมิเตอร์ไฟฟ้าและระบบสื่อสาร</Eyebrow>
      <h1 class="mt-3 font-display text-4xl sm:text-5xl font-bold leading-tight text-ink">
        ระบบ <span class="text-accent">วัด</span> และ <span class="text-accent">สื่อสาร</span> พลังงานไฟฟ้า
        สำหรับโครงการระดับอุตสาหกรรม
      </h1>
      <p class="mt-5 text-lg text-ink-2 leading-relaxed">
        ผู้แทนจำหน่าย ให้คำปรึกษา ออกแบบและติดตั้งระบบสื่อสารทางไฟฟ้าสำหรับ Energy Meter, Power
        Quality Meter (PQM) และอุปกรณ์สื่อสาร — TOU Meters &amp; Power Quality Analyzer
        สำหรับโครงการโรงไฟฟ้า, โซลาร์, รูฟท็อป และโซลาร์ฟาร์มลอยน้ำ
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <Button href="/products">ดูผลิตภัณฑ์</Button>
        <Button href="/contact" variant="secondary">ปรึกษาวิศวกร →</Button>
      </div>
    </div>
    <div class="aspect-square max-w-md mx-auto w-full">
      <HeroMeter />
    </div>
  </Section>

  <!-- Brand strip -->
  <div class="border-y border-line bg-surface py-8">
    <div class="max-w-6xl mx-auto px-5">
      <p class="text-center font-en text-sm text-ink-3 mb-4">
        แบรนด์ระดับโลกที่เราเป็นตัวแทนจัดจำหน่าย
      </p>
      <div
        class="flex flex-wrap justify-center gap-x-10 gap-y-3 font-display font-bold text-xl text-ink-2"
      >
        {brands.map((brand) => <span>{brand}</span>)}
      </div>
    </div>
  </div>

  <!-- About teaser -->
  <Section width="wide">
    <SectionHeading
      eyebrow="เกี่ยวกับเรา"
      heading="วิศวกรรมที่เชื่อถือได้ ตั้งแต่การออกแบบจนถึงการสื่อสาร"
      lede={`${SITE.name.th} ก่อตั้งขึ้นเพื่อตอบโจทย์อุตสาหกรรมพลังงานของประเทศไทย เราเป็นผู้แทนจำหน่ายอุปกรณ์มิเตอร์ไฟฟ้าและอุปกรณ์สื่อสารระดับโลก พร้อมให้บริการครบวงจร ตั้งแต่ที่ปรึกษา ออกแบบ จัดหา ติดตั้ง และซ่อมบำรุง`}
    />
    <a href="/about" class="mt-6 inline-block font-semibold text-accent hover:text-accent-deep">
      อ่านเพิ่มเติมเกี่ยวกับเรา →
    </a>
  </Section>

  <!-- Services teaser -->
  <Section width="wide">
    <SectionHeading
      eyebrow="บริการของเรา"
      heading="บริการครบวงจรสำหรับระบบมิเตอร์ไฟฟ้าและการสื่อสาร"
      lede="ตั้งแต่การให้คำปรึกษา ออกแบบทางวิศวกรรม จัดหาอุปกรณ์ ไปจนถึงการติดตั้ง ทดสอบ และซ่อมบำรุง — เรารับผิดชอบทุกขั้นตอนของโครงการ"
    />
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        SERVICES.map((service) => (
          <Card as="article" interactive>
            <div class="font-en text-xs text-ink-3">{service.num}</div>
            <h3 class="mt-2 font-display font-semibold text-lg text-ink">{service.title}</h3>
            <p class="mt-2 text-sm text-ink-2 leading-relaxed">{service.desc}</p>
          </Card>
        ))
      }
    </div>
    <a href="/services" class="mt-8 inline-block font-semibold text-accent hover:text-accent-deep">
      ดูบริการทั้งหมด →
    </a>
  </Section>

  <!-- Persona teasers: AMR + Billing solutions -->
  <Section width="wide">
    <SectionHeading
      eyebrow="AMR และระบบคิดเงิน"
      heading="ออกแบบมาให้ตรงกับบทบาทของคุณในอุตสาหกรรมพลังงาน"
      lede="แพลตฟอร์ม AMR และ Billing ของเรา — ออกแบบเฉพาะสำหรับ Solar Developer, การไฟฟ้า และผู้พัฒนาพลังงานหมุนเวียน"
    />
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <Card as="article" href="/solutions/billing#ppa-billing" interactive>
        <div class="font-en text-xs text-ink-3">สำหรับ Solar Developer</div>
        <h3 class="mt-2 font-display font-semibold text-lg text-ink">Private PPA คิดค่าไฟยังไง?</h3>
        <p class="mt-2 text-sm text-ink-2 leading-relaxed">
          ออก Private PPA Billing ตาม kWh จริง พร้อมใบแจ้งหนี้และรายงาน Investor อัตโนมัติ
        </p>
      </Card>
      <Card as="article" href="/solutions/amr#meter-data-management" interactive>
        <div class="font-en text-xs text-ink-3">สำหรับการไฟฟ้า</div>
        <h3 class="mt-2 font-display font-semibold text-lg text-ink">
          MDM (ระบบจัดการข้อมูลมิเตอร์)
        </h3>
        <p class="mt-2 text-sm text-ink-2 leading-relaxed">
          รวบรวมและกระทบยอดข้อมูลจาก AMR ของทุกมิเตอร์เข้าไว้ที่เดียว พร้อม Audit trail
          ตรวจสอบย้อนหลังได้
        </p>
      </Card>
      <Card as="article" href="/solutions/amr" interactive>
        <div class="font-en text-xs text-ink-3">สำหรับผู้พัฒนาพลังงานหมุนเวียน</div>
        <h3 class="mt-2 font-display font-semibold text-lg text-ink">
          VSPP SPP IPP ต่างกันอย่างไร?
        </h3>
        <p class="mt-2 text-sm text-ink-2 leading-relaxed">
          มอนิเตอร์ผลผลิตและอ่านมิเตอร์อัตโนมัติผ่าน AMR รองรับโครงการทุกขนาด ตั้งแต่ VSPP จนถึง IPP
        </p>
      </Card>
    </div>
  </Section>

  <!-- Featured products -->
  <Section width="wide">
    <SectionHeading eyebrow="ผลิตภัณฑ์" heading="Energy Meter และอุปกรณ์สื่อสารระดับโลก" />
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {products.map((product) => <ProductCard product={product} headingLevel="h3" />)}
    </div>
    <a href="/products" class="mt-8 inline-block font-semibold text-accent hover:text-accent-deep">
      ดูผลิตภัณฑ์ทั้งหมด →
    </a>
  </Section>

  <!-- Contact CTA -->
  <CTABand
    width="wide"
    headingSize="lg"
    heading="พร้อมเป็นส่วนหนึ่งของโครงการคุณ"
    body="ส่งรายละเอียดโครงการของคุณ ทีมวิศวกรของเราจะประเมินขอบเขตงาน และเสนอราคาให้ภายใน 2 วันทำการ"
    ctaLabel="ติดต่อเรา →"
  />
</BaseLayout>
