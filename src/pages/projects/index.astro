---
import Card from '../../components/ui/Card.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import StatGrid from '../../components/ui/StatGrid.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSortedProjects } from '../../lib/collections';

const projects = await getSortedProjects();
---

<BaseLayout
  title="โครงการของเรา"
  description="โครงการที่ Advanced Grid ออกแบบ จัดหา และติดตั้งจริง — ตั้งแต่โซลาร์ฟาร์ม โรงไฟฟ้า ไปจนถึงระบบ Smart Meter สำหรับอาคาร"
>
  <Section width="wide" spacing="lg">
    <SectionHeading
      as="h1"
      eyebrow="กรณีศึกษาลูกค้า"
      heading="ผลงานทั่วประเทศไทย ในทุกประเภทโครงการพลังงาน"
      lede="โครงการที่ Advanced Grid ออกแบบ จัดหา และติดตั้งจริง — กดเข้าไปดูรายละเอียดแต่ละโครงการ ตั้งแต่โจทย์ ทางออก จนถึงผลลัพธ์"
    />

    <div class="mt-10 grid sm:grid-cols-2 gap-6">
      {
        projects.map((project) =>
          project.data.status === 'published' ? (
            <Card href={`/projects/${project.id}`} interactive>
              <div class="text-sm font-en font-semibold text-accent">{project.data.location}</div>
              <h2 class="mt-1 font-display font-semibold text-lg text-ink">{project.data.title}</h2>
              {project.data.stats && <StatGrid stats={project.data.stats} class="mt-4" />}
              <span class="mt-4 inline-block text-sm font-semibold text-accent">
                อ่านเรื่องราว →
              </span>
            </Card>
          ) : (
            <div class="rounded-lg border border-dashed border-line-strong bg-surface p-6 opacity-70">
              <div class="text-sm font-en font-semibold text-ink-3">{project.data.location}</div>
              <h2 class="mt-1 font-display font-semibold text-lg text-ink">{project.data.title}</h2>
              <p class="mt-3 text-sm text-ink-3">
                [pending case study data] — รอข้อมูลยืนยันก่อนเผยแพร่รายละเอียด
              </p>
            </div>
          )
        )
      }
    </div>
  </Section>
</BaseLayout>
