---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="โครงการของเรา | Advanced Grid Co., Ltd."
  description="โครงการที่ Advanced Grid ออกแบบ จัดหา และติดตั้งจริง — ตั้งแต่โซลาร์ฟาร์ม โรงไฟฟ้า ไปจนถึงระบบ Smart Meter สำหรับอาคาร"
>
  <section class="max-w-6xl mx-auto px-5 py-16 lg:py-24">
    <SectionHeading
      as="h1"
      eyebrow="กรณีศึกษาลูกค้า"
      heading="ผลงานทั่วประเทศไทย ในทุกประเภทโครงการพลังงาน"
      lede="โครงการที่ Advanced Grid ออกแบบ จัดหา และติดตั้งจริง — กดเข้าไปดูรายละเอียดแต่ละโครงการ ตั้งแต่โจทย์ ทางออก จนถึงผลลัพธ์"
    />

    <div class="mt-10 grid sm:grid-cols-2 gap-6">
      {projects.map((p) => (
        p.data.status === 'published' ? (
          <a href={`/projects/${p.id}`} class="rounded-lg border border-line bg-bg-elev p-6 hover:shadow-lg transition-shadow">
            <div class="text-sm font-en font-semibold text-accent">{p.data.location}</div>
            <h2 class="mt-1 font-display font-semibold text-lg text-ink">{p.data.title}</h2>
            {p.data.stats && (
              <div class="mt-4 grid grid-cols-3 gap-2 border-t border-line pt-4">
                {p.data.stats.map((s) => (
                  <div>
                    <div class="font-display font-bold text-ink">{s.value}</div>
                    <div class="text-xs text-ink-3">{s.label}</div>
                  </div>
                ))}
              </div>
            )}
            <span class="mt-4 inline-block text-sm font-semibold text-accent">อ่านเรื่องราว →</span>
          </a>
        ) : (
          <div class="rounded-lg border border-dashed border-line-strong bg-surface p-6 opacity-70">
            <div class="text-sm font-en font-semibold text-ink-3">{p.data.location}</div>
            <h2 class="mt-1 font-display font-semibold text-lg text-ink">{p.data.title}</h2>
            <p class="mt-3 text-sm text-ink-3">[pending case study data] — รอข้อมูลยืนยันก่อนเผยแพร่รายละเอียด</p>
          </div>
        )
      ))}
    </div>
  </section>
</BaseLayout>
