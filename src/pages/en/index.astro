---
import HomeBody from '../../components/pages/HomeBody.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getFeaturedProducts } from '../../lib/collections';
import { HOME_COPY } from '../../lib/i18n/pages/home';

const products = await getFeaturedProducts('en');
const t = HOME_COPY.en;
---

<BaseLayout title={t.metaTitle} exactTitle description={t.metaDescription}>
  <HomeBody products={products} />
</BaseLayout>
