---
import { render } from 'astro:content';
import SpecTable from '../../components/SpecTable.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import CTABand from '../../components/ui/CTABand.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Pill from '../../components/ui/Pill.astro';
import type { ProductEntry } from '../../content.config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSortedProducts } from '../../lib/collections';
import { breadcrumbSchema, productSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const products = await getSortedProducts();
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

interface Props {
  product: ProductEntry;
}

const { product } = Astro.props;
const { Content } = await render(product);

const schema = productSchema(product, Astro.site);
const breadcrumb = breadcrumbSchema(
  [{ name: 'ผลิตภัณฑ์', href: '/products' }, { name: product.data.name }],
  Astro.site
);
---

<BaseLayout
  title={`${product.data.name} — ${product.data.tagline}`}
  description={product.data.description}
  ogType="product"
  ogImage={product.data.image}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />
  </Fragment>

  <article class="max-w-3xl mx-auto px-5 py-16 lg:py-24">
    <Breadcrumb href="/products" label="← ผลิตภัณฑ์ทั้งหมด" />
    <Eyebrow class="mt-6 block">{product.data.brand}</Eyebrow>
    <h1 class="mt-2 font-display text-3xl sm:text-4xl font-bold text-ink">{product.data.name}</h1>
    <div class="mt-1 text-ink-3">{product.data.tagline}</div>

    <div class="mt-6 flex flex-wrap gap-2">
      {product.data.specs.map((spec) => <Pill size="md">{spec}</Pill>)}
    </div>

    <div class="mt-8 prose prose-neutral max-w-none text-ink-2 leading-relaxed">
      <Content />
    </div>

    {
      product.data.specTable && (
        <SpecTable
          heading="ข้อมูลจำเพาะ"
          groups={product.data.specTable}
          source={product.data.specSource}
        />
      )
    }

    <CTABand
      layout="card"
      heading={`สนใจ ${product.data.name}?`}
      body="ส่งรายละเอียดโครงการของคุณ ทีมวิศวกรของเราจะแนะนำรุ่นที่เหมาะสมและเสนอราคาให้"
      ctaLabel="ขอใบเสนอราคา →"
    />
  </article>
</BaseLayout>
