---
import ContactForm from '../components/ContactForm.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Field from '../components/ui/Field.astro';
import Section from '../components/ui/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatAddressEn, SITE } from '../lib/site';

const mapQuery = encodeURIComponent(formatAddressEn(SITE.addresses.sales.en));

const topics = [
  'ขอใบเสนอราคา (Energy Meter)',
  'ขอใบเสนอราคา (PQM)',
  'ออกแบบ Meter Box / Communication Box',
  'สอบเทียบมิเตอร์ (Calibration)',
  'ปรึกษาทางวิศวกรรม',
  'อื่นๆ',
];
---

<BaseLayout
  title="ติดต่อเรา"
  description={`ติดต่อ${SITE.name.th} โทร ${SITE.phone.display} อีเมล ${SITE.email} สำนักงานใหญ่และสำนักงานขาย MRV Building ปากเกร็ด นนทบุรี`}
>
  <Section width="wide" spacing="lg" innerClass="grid lg:grid-cols-2 gap-12">
    <div>
      <Eyebrow>ติดต่อเรา</Eyebrow>
      <h1 class="mt-3 font-display text-3xl sm:text-4xl font-bold text-ink">
        พร้อมเป็นส่วนหนึ่งของโครงการคุณ
      </h1>
      <p class="mt-4 text-ink-2 leading-relaxed">
        ส่งรายละเอียดโครงการของคุณ ทีมวิศวกรของเราจะประเมินขอบเขตงาน และเสนอราคาให้ภายใน 2 วันทำการ
      </p>

      <div class="mt-8">
        <h2 class="font-display font-semibold text-ink">ติดต่อโดยตรง</h2>
        <ul class="mt-3 space-y-3 text-sm">
          <li>
            <strong class="block text-ink">โทรศัพท์</strong>
            <a href={SITE.phone.href} class="text-ink-2 hover:text-accent">{SITE.phone.display}</a>
          </li>
          <li>
            <strong class="block text-ink">อีเมล</strong>
            <a href={`mailto:${SITE.email}`} class="text-ink-2 hover:text-accent">{SITE.email}</a>
          </li>
          <li>
            <strong class="block text-ink">LINE Official</strong>
            <a href={SITE.line.href} class="text-ink-2 hover:text-accent">{SITE.line.id}</a>
          </li>
        </ul>
      </div>

      <div class="mt-8">
        <h2 class="font-display font-semibold text-ink">ที่ตั้ง</h2>
        <ul class="mt-3 space-y-4 text-sm">
          <li>
            <strong class="block text-ink">{SITE.addresses.registered.label.th}</strong>
            <span class="text-ink-2">{SITE.addresses.registered.th}</span>
          </li>
          <li>
            <strong class="block text-ink">{SITE.addresses.sales.label.th}</strong>
            <span class="text-ink-2">{SITE.addresses.sales.th}</span>
          </li>
          <li>
            <strong class="block text-ink">เลขทะเบียนนิติบุคคล</strong>
            <span class="text-ink-2">{SITE.registration}</span>
          </li>
        </ul>
      </div>

      <div class="mt-8 aspect-video rounded-lg overflow-hidden border border-line">
        <iframe
          title="แผนที่สำนักงานขาย Advanced Grid"
          src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
          class="w-full h-full"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>

    <ContactForm subject="Advanced Grid — New contact request" formId="contact" class="h-fit">
      <div class="grid sm:grid-cols-2 gap-5">
        <Field id="cf-name" name="name" label="ชื่อ-นามสกุล" required />
        <Field id="cf-company" name="company" label="บริษัท" />
      </div>
      <div class="grid sm:grid-cols-2 gap-5">
        <Field id="cf-email" name="email" label="อีเมล" type="email" required />
        <Field id="cf-phone" name="phone" label="เบอร์โทร" type="tel" />
      </div>
      <Field id="cf-topic" name="topic" label="หัวข้อ" type="select">
        {topics.map((topic) => <option>{topic}</option>)}
      </Field>
      <Field id="cf-msg" name="message" label="รายละเอียดโครงการ" type="textarea" />
    </ContactForm>
  </Section>
</BaseLayout>
