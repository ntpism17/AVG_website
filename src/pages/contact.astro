---
import BaseLayout from '../layouts/BaseLayout.astro';

const mapQuery = encodeURIComponent('MRV Building, 38/5 Moo 4, Bang Phlap, Pak Kret, Nonthaburi 11120');
---

<BaseLayout
  title="ติดต่อเรา | Advanced Grid Co., Ltd."
  description="ติดต่อบริษัท แอดวานซ์ กริด จำกัด โทร 099-226-8000 อีเมล advancedgrid@gmail.com สำนักงานใหญ่และสำนักงานขาย MRV Building ปากเกร็ด นนทบุรี"
>
  <section class="max-w-6xl mx-auto px-5 py-16 lg:py-24 grid lg:grid-cols-2 gap-12">
    <div>
      <span class="font-en text-sm font-semibold text-accent">ติดต่อเรา</span>
      <h1 class="mt-3 font-display text-3xl sm:text-4xl font-bold text-ink">พร้อมเป็นส่วนหนึ่งของโครงการคุณ</h1>
      <p class="mt-4 text-ink-2 leading-relaxed">
        ส่งรายละเอียดโครงการของคุณ ทีมวิศวกรของเราจะประเมินขอบเขตงาน และเสนอราคาให้ภายใน 2 วันทำการ
      </p>

      <div class="mt-8">
        <h2 class="font-display font-semibold text-ink">ติดต่อโดยตรง</h2>
        <ul class="mt-3 space-y-3 text-sm">
          <li><strong class="block text-ink">โทรศัพท์</strong><a href="tel:+66992268000" class="text-ink-2 hover:text-accent">099-226-8000</a></li>
          <li><strong class="block text-ink">อีเมล</strong><a href="mailto:advancedgrid@gmail.com" class="text-ink-2 hover:text-accent">advancedgrid@gmail.com</a></li>
          <li><strong class="block text-ink">LINE Official</strong><a href="https://line.me/ti/p/~856khvjl" class="text-ink-2 hover:text-accent">@856khvjl</a></li>
        </ul>
      </div>

      <div class="mt-8">
        <h2 class="font-display font-semibold text-ink">ที่ตั้ง</h2>
        <ul class="mt-3 space-y-4 text-sm">
          <li>
            <strong class="block text-ink">ที่อยู่จดทะเบียน</strong>
            <span class="text-ink-2">99/6116 หมู่ 2 ต.ท่าอิฐ อ.ปากเกร็ด จ.นนทบุรี 11120</span>
          </li>
          <li>
            <strong class="block text-ink">สำนักงานขาย (MRV Building)</strong>
            <span class="text-ink-2">อาคาร MRV, 38/5 หมู่ 4 ต.บางพลับ อ.ปากเกร็ด จ.นนทบุรี 11120</span>
          </li>
          <li>
            <strong class="block text-ink">เลขทะเบียนนิติบุคคล</strong>
            <span class="text-ink-2">0125563021024</span>
          </li>
        </ul>
      </div>

      <div class="mt-8 aspect-video rounded-lg overflow-hidden border border-line">
        <iframe
          title="แผนที่สำนักงานขาย Advanced Grid"
          src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
          class="w-full h-full"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>

    <form
      class="space-y-5 rounded-lg border border-line bg-bg-elev p-8 h-fit"
      action="https://api.web3forms.com/submit"
      method="POST"
      data-form="contact"
    >
      <input type="hidden" name="access_key" value="PENDING_WEB3FORMS_ACCESS_KEY" />
      <input type="hidden" name="subject" value="Advanced Grid — New contact request" />

      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <label for="cf-name" class="block text-sm font-medium text-ink">ชื่อ-นามสกุล</label>
          <input id="cf-name" name="name" type="text" required class="mt-1 w-full rounded-md border border-line-strong px-3 py-2 bg-bg-elev text-ink" />
        </div>
        <div>
          <label for="cf-company" class="block text-sm font-medium text-ink">บริษัท</label>
          <input id="cf-company" name="company" type="text" class="mt-1 w-full rounded-md border border-line-strong px-3 py-2 bg-bg-elev text-ink" />
        </div>
      </div>
      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <label for="cf-email" class="block text-sm font-medium text-ink">อีเมล</label>
          <input id="cf-email" name="email" type="email" required class="mt-1 w-full rounded-md border border-line-strong px-3 py-2 bg-bg-elev text-ink" />
        </div>
        <div>
          <label for="cf-phone" class="block text-sm font-medium text-ink">เบอร์โทร</label>
          <input id="cf-phone" name="phone" type="tel" class="mt-1 w-full rounded-md border border-line-strong px-3 py-2 bg-bg-elev text-ink" />
        </div>
      </div>
      <div>
        <label for="cf-topic" class="block text-sm font-medium text-ink">หัวข้อ</label>
        <select id="cf-topic" name="topic" class="mt-1 w-full rounded-md border border-line-strong px-3 py-2 bg-bg-elev text-ink">
          <option>ขอใบเสนอราคา (Energy Meter)</option>
          <option>ขอใบเสนอราคา (PQM)</option>
          <option>ออกแบบ Meter Box / Communication Box</option>
          <option>สอบเทียบมิเตอร์ (Calibration)</option>
          <option>ปรึกษาทางวิศวกรรม</option>
          <option>อื่นๆ</option>
        </select>
      </div>
      <div>
        <label for="cf-msg" class="block text-sm font-medium text-ink">รายละเอียดโครงการ</label>
        <textarea id="cf-msg" name="message" rows="4" class="mt-1 w-full rounded-md border border-line-strong px-3 py-2 bg-bg-elev text-ink"></textarea>
      </div>
      <button type="submit" class="w-full rounded-md bg-accent px-6 py-3 font-semibold text-white hover:bg-accent-deep transition-colors">ส่งคำขอ →</button>
    </form>
  </section>
</BaseLayout>
