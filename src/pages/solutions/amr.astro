---
import ContactForm from '../../components/ContactForm.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Field from '../../components/ui/Field.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const pillars = [
  {
    id: undefined as string | undefined,
    title: 'ฝั่งผลิต',
    sub: 'Real-time Solar Monitoring',
    desc: 'มอนิเตอร์ประสิทธิภาพระบบโซลาร์แบบเรียลไทม์ พร้อมแจ้งเตือนเมื่อมีปัญหา และรายงานลดคาร์บอนสำหรับงาน ESG',
    items: [
      'รายงาน kWh / kWp / Performance Ratio รายอินเวอร์เตอร์',
      'แจ้งเตือน LINE / Email เมื่อระบบมีปัญหา',
      'รายงานการลดคาร์บอน (CO₂ saved) สำหรับ ESG',
      'ดูย้อนหลังได้ตั้งแต่นาทีจนถึงปี',
    ],
  },
  {
    id: 'amr-integration',
    title: 'ฝั่งเก็บข้อมูล',
    sub: 'Automatic Meter Reading (AMR)',
    desc: 'อ่านมิเตอร์ไร้สายอัตโนมัติ ดึงข้อมูลการใช้ไฟและผลผลิตโซลาร์เข้าสู่ระบบแบบไม่ต้องจดมิเตอร์ด้วยมือ เป็นชั้นข้อมูลตั้งต้นให้ระบบคิดเงินและรายงานอื่น ๆ ต่อยอดได้',
    items: [
      'อ่านมิเตอร์อัตโนมัติผ่าน AMR — รองรับ Mk6E, Premier 550, Elite 500',
      'ดึงข้อมูลตามรอบเวลาที่ตั้งไว้ ไม่ต้องส่งคนไปจดหน้างาน',
      'ข้อมูลพร้อมส่งต่อให้ระบบคิดเงิน (Billing) หรือ SCADA ของลูกค้าแบบ real-time',
    ],
  },
  {
    id: 'meter-data-management',
    title: 'ฝั่งจัดการข้อมูล',
    sub: 'Meter Data Management (MDM)',
    desc: 'รวบรวมและกระทบยอดข้อมูลจาก AMR ของทุกมิเตอร์เข้าไว้ที่เดียว ตรวจสอบความผิดปกติของข้อมูลก่อนส่งต่อ เป็นชั้นข้อมูลที่ระบบคิดเงินและรายงานทางการเงินต้องอ้างอิงได้อย่างน่าเชื่อถือ',
    items: [
      'กระทบยอด (reconcile) ข้อมูล Revenue Meter กับข้อมูลจาก AMR อัตโนมัติ',
      'เก็บ Audit trail ของข้อมูลมิเตอร์ทุกจุดแบบย้อนหลังได้',
      'จ่ายข้อมูลที่ตรวจสอบแล้วให้ระบบคิดเงินและ SCADA ผ่าน API เดียว',
    ],
  },
];

const personas = [
  {
    title: 'Solar Developer / EPC',
    desc: 'ผู้พัฒนาโครงการและผู้รับเหมา EPC ที่ต้องส่งมอบงาน Commissioning ให้ลูกค้า ผ่าน Witness Test การไฟฟ้า และตั้งระบบมอนิเตอร์ก่อน COD',
    items: [
      'Commissioning Dashboard — สรุปผล Performance Test รายไซต์',
      'ส่งมอบเอกสาร M&V พร้อมข้อมูลย้อนหลังให้ลูกค้าตอน Handover',
      'ตั้งระบบเทียบ Expected vs Actual ตั้งแต่วันแรกของ Operation',
    ],
  },
  {
    title: 'Asset Manager / O&M Team',
    desc: 'ทีมที่ดูแลโครงการโซลาร์หลายไซต์หลังเปิดใช้งานแล้ว ต้องการเครื่องมือ ติดตาม Performance, จัดการ Ticket / Alarm และวางแผน Maintenance ให้ตรงเวลา',
    items: [
      'Alarm Center — รวมการแจ้งเตือนจากทุกไซต์ จัดลำดับความสำคัญอัตโนมัติ',
      'ติดตาม PR, Availability, Energy Yield รายอินเวอร์เตอร์ และเทียบกับ Benchmark',
      'Work Order / Maintenance Log ดูประวัติย้อนหลังของทุกอุปกรณ์',
    ],
  },
];

const inverterIntegrations = ['Huawei FusionSolar', 'SMA', 'Sungrow', 'SolarEdge'];
const meterIntegrations = ['Mk6E', 'Premier 550', 'Elite 500'];

const businessTypes = [
  'Solar Developer / EPC',
  'IPP / Solar PPA Operator',
  'Asset Manager / O&M',
  'ผู้ลงทุน / Investor',
];

const portfolioSizes = ['ต่ำกว่า 500 kWp', '500 kWp – 5 MWp', '5 MWp – 50 MWp', 'มากกว่า 50 MWp'];
---

<BaseLayout
  title="AMR — ระบบอ่านมิเตอร์อัตโนมัติและมอนิเตอร์โซลาร์แบบเรียลไทม์"
  description="AMR: ระบบมอนิเตอร์ผลผลิตโซลาร์และอ่านมิเตอร์ไฟฟ้าอัตโนมัติ (Automatic Meter Reading) รองรับ Mk6E, Premier 550, Elite 500 เชื่อมต่อ Huawei FusionSolar, SMA, Sungrow, SolarEdge พร้อมส่งข้อมูลต่อให้ระบบคิดเงิน (Billing) สำหรับ Solar Developer, EPC และทีม O&M และ MDM (ระบบจัดการข้อมูลมิเตอร์)"
>
  <Section width="wide" spacing="lg">
    <Eyebrow>ผลิตภัณฑ์ใหม่ · 2026</Eyebrow>
    <h1 class="mt-3 font-display text-4xl sm:text-5xl font-bold leading-tight text-ink">
      AMR — มอนิเตอร์ผลผลิตโซลาร์ พร้อมอ่านมิเตอร์อัตโนมัติ
    </h1>
    <p class="mt-5 text-lg text-ink-2 leading-relaxed max-w-3xl">
      มอนิเตอร์ผลผลิตของทุกไซต์แบบเรียลไทม์ และอ่านมิเตอร์ไฟฟ้าอัตโนมัติผ่าน AMR
      โดยไม่ต้องส่งคนไปจดหน้างาน — เป็นชั้นข้อมูลตั้งต้นที่แม่นยำ พร้อมส่งต่อให้ระบบ{' '}
      <a href="/solutions/billing" class="text-accent font-semibold hover:text-accent-deep"
        >คิดเงิน (Billing)</a
      > หรือ SCADA ของลูกค้าใช้งานต่อได้ทันที
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <Button href="#quote">ขอทดลองใช้งาน Demo →</Button>
      <Button href="#quote" variant="secondary">ปรึกษาผู้เชี่ยวชาญ</Button>
    </div>
  </Section>

  <Section band="surface-y" width="wide">
    <SectionHeading
      eyebrow="3 ขาหลักของระบบ"
      heading="ครบทั้งฝั่งผลิต ฝั่งเก็บข้อมูล และฝั่งจัดการข้อมูล (MDM)"
    />
    <div class="mt-10 grid lg:grid-cols-3 gap-6">
      {
        pillars.map((pillar) => (
          <Card as="article" id={pillar.id}>
            <h3 class="font-display font-bold text-lg text-ink">{pillar.title}</h3>
            <div class="font-en text-sm text-accent">{pillar.sub}</div>
            <p class="mt-3 text-sm text-ink-2 leading-relaxed">{pillar.desc}</p>
            <ul class="mt-4 space-y-2 text-sm text-ink-2">
              {pillar.items.map((item) => (
                <li class="flex gap-2">
                  <span class="text-accent">✓</span>
                  {item}
                </li>
              ))}
            </ul>
          </Card>
        ))
      }
    </div>
  </Section>

  <Section width="wide">
    <SectionHeading
      eyebrow="ออกแบบมาเพื่อใคร"
      heading="2 บทบาทใน Solar Industry ที่ AMR ตอบโจทย์ที่สุด"
    />
    <div class="mt-10 grid lg:grid-cols-2 gap-6">
      {
        personas.map((persona) => (
          <Card as="article">
            <h3 class="font-display font-bold text-lg text-ink">{persona.title}</h3>
            <p class="mt-3 text-sm text-ink-2 leading-relaxed">{persona.desc}</p>
            <ul class="mt-4 space-y-2 text-sm text-ink-2 list-disc list-inside">
              {persona.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </Card>
        ))
      }
    </div>
  </Section>

  <Section band="surface-y">
    <h2 class="font-display text-2xl font-bold text-ink text-center">
      ระบบเชื่อมต่ออุปกรณ์ที่คุณมีอยู่แล้ว
    </h2>
    <p class="mt-3 text-center text-ink-2">
      API เชื่อมตรงกับอินเวอร์เตอร์ {inverterIntegrations.join(', ')} และ SCADA ของลูกค้า — พร้อมอ่านมิเตอร์ผ่าน
      AMR รองรับ {meterIntegrations.join(', ')}
    </p>
    <div
      class="mt-6 flex flex-wrap justify-center gap-x-8 gap-y-2 font-display font-semibold text-ink-2"
    >
      {inverterIntegrations.map((name) => <span>{name}</span>)}
      {meterIntegrations.map((name) => <span>{name}</span>)}
    </div>
  </Section>

  <Section id="quote" width="narrow">
    <h2 class="font-display text-2xl font-bold text-ink text-center">ขอใบเสนอราคา + ทดลอง Demo</h2>
    <p class="mt-2 text-center text-ink-2">
      ตอบกลับภายใน 1 วันทำการ · ทดลองใช้งานฟรี 30 วัน ไม่ต้องใช้บัตรเครดิต
    </p>

    <ContactForm subject="AMR — Quote request" formId="amr-quote" class="mt-8">
      <div class="grid sm:grid-cols-2 gap-5">
        <Field id="qf-name" name="name" label="ชื่อ-นามสกุล" required />
        <Field id="qf-company" name="company" label="บริษัท / โครงการ" />
      </div>
      <div class="grid sm:grid-cols-2 gap-5">
        <Field id="qf-email" name="email" label="อีเมล" type="email" required />
        <Field id="qf-phone" name="phone" label="เบอร์โทร" type="tel" />
      </div>
      <Field id="qf-type" name="business_type" label="ประเภทธุรกิจ" type="select">
        {businessTypes.map((type) => <option>{type}</option>)}
      </Field>
      <Field id="qf-rooms" name="portfolio_size" label="ขนาดพอร์ตโซลาร์ (โดยประมาณ)" type="select">
        {portfolioSizes.map((size) => <option>{size}</option>)}
      </Field>
      <Field id="qf-msg" name="message" label="ข้อความเพิ่มเติม" type="textarea" />
      <div class="flex items-start gap-2">
        <input id="qf-consent" name="consent" type="checkbox" required class="mt-1" />
        <label for="qf-consent" class="text-sm text-ink-2">
          ยินยอมให้ Advanced Grid ใช้ข้อมูลเพื่อติดต่อกลับ
        </label>
      </div>
    </ContactForm>
    <p class="mt-4 text-xs text-ink-3 text-center">ข้อมูลเก็บในประเทศไทย ปลอดภัยตาม PDPA</p>
  </Section>
</BaseLayout>
