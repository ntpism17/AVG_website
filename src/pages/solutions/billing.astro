---
import ContactForm from '../../components/ContactForm.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Field from '../../components/ui/Field.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const pillars = [
  {
    id: 'tou-billing',
    title: 'ฝั่งคำนวณ',
    sub: 'Smart Tariff Engine',
    desc: 'คำนวณค่าไฟตามเรท MEA/PEA จริง รวมถึง TOU และเฉลี่ยสัดส่วนไฟโซลาร์รายห้องอย่างเที่ยงธรรม — ต่อยอดจากข้อมูลมิเตอร์ที่ระบบ AMR ดึงเข้ามาอัตโนมัติ',
    items: [
      'คำนวณตามเรท MEA / PEA / TOU จริง อัปเดตอัตโนมัติ',
      'เฉลี่ยไฟโซลาร์รายห้องตามสัดส่วนการใช้งานจริง',
      'Audit trail ตรวจสอบย้อนหลังได้ทุกการคำนวณ',
    ],
  },
  {
    id: undefined as string | undefined,
    title: 'ฝั่งคิดเงิน',
    sub: 'Automated Billing & Collection',
    desc: 'ออกใบแจ้งหนี้และใบเสร็จ PDF อัตโนมัติ แนบ QR Code พร้อมจ่าย พร้อมระบบหลังบ้านสรุปรายได้และติดตามการค้างชำระ',
    items: [
      'สร้างบิล PDF ทั้งตึก ในคลิกเดียว',
      'แนบ PromptPay QR Code อัตโนมัติ จ่ายในแอปธนาคารได้ทันที',
      'ส่งบิลผ่าน LINE / SMS / Email',
      'Dashboard รายรับ รายจ่าย ค้างชำระ ครบในที่เดียว',
    ],
  },
];

const personas = [
  {
    title: 'IPP / Solar PPA Operator',
    desc: 'ผู้ลงทุนติดตั้งโซลาร์และขายไฟแบบ Private PPA / Direct PPA ที่ต้องออกบิลตามสัญญารายลูกค้า และรายงานผลให้ Offtaker, Investor, และ Lender',
    items: [
      'PPA Billing ตาม kWh จริง — รองรับ Tier rate, Escalator, Discount',
      'Investor / Lender Report สรุป Revenue, Yield, Availability รายเดือน',
      'พอร์ตหลายไซต์ — เปรียบเทียบ Performance ระหว่างไซต์ได้ทันที',
    ],
  },
];

const businessTypes = [
  'Solar Developer / EPC',
  'IPP / Solar PPA Operator',
  'Asset Manager / O&M',
  'ผู้ลงทุน / Investor',
];

const portfolioSizes = ['ต่ำกว่า 500 kWp', '500 kWp – 5 MWp', '5 MWp – 50 MWp', 'มากกว่า 50 MWp'];
---

<BaseLayout
  title="ระบบคิดเงิน (Billing) — ออก PPA Billing และเก็บเงินอัตโนมัติจากข้อมูลโซลาร์จริง"
  description="ซอฟต์แวร์บิลลิ่งพลังงาน (Energy Billing Software) สำหรับคำนวณค่าไฟตามเรท MEA/PEA/TOU และออก Private PPA Billing ตาม kWh จริง พร้อมใบแจ้งหนี้ PDF, PromptPay QR และรายงาน Investor ต่อยอดจากข้อมูลมิเตอร์ของระบบ AMR สำหรับ IPP และ Solar PPA Operator"
>
  <Section width="wide" spacing="lg">
    <Eyebrow>ผลิตภัณฑ์ใหม่ · 2026</Eyebrow>
    <h1 class="mt-3 font-display text-4xl sm:text-5xl font-bold leading-tight text-ink">
      ระบบคิดเงิน (Billing) — คิดค่าไฟและออกบิลอัตโนมัติจากข้อมูลจริง
    </h1>
    <p class="mt-5 text-lg text-ink-2 leading-relaxed max-w-3xl">
      แอปพลิเคชันเลเยอร์บนสุดที่รับข้อมูลมิเตอร์จากระบบ{' '}
      <a href="/solutions/amr" class="text-accent font-semibold hover:text-accent-deep">AMR</a>
      มาคำนวณค่าไฟตามเรทจริง ออก PPA Billing ตาม kWh จริง พร้อมส่งรายงานให้ Offtaker และ Investor — ออกแบบมาเฉพาะสำหรับ
      Solar Developer, EPC และ Solar PPA Operator ที่ต้องการสเกลโครงการหลายไซต์โดยไม่เพิ่มทีม Back-office
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <Button href="#quote">ขอทดลองใช้งาน Demo →</Button>
      <Button href="#quote" variant="secondary">ปรึกษาผู้เชี่ยวชาญ</Button>
    </div>
  </Section>

  <Section id="ppa-billing" band="surface-y" width="wide">
    <SectionHeading eyebrow="2 ขาหลักของระบบ" heading="ครบทั้งฝั่งคำนวณและฝั่งคิดเงิน" />
    <div class="mt-10 grid lg:grid-cols-2 gap-6">
      {
        pillars.map((pillar) => (
          <Card as="article" id={pillar.id}>
            <h3 class="font-display font-bold text-lg text-ink">{pillar.title}</h3>
            <div class="font-en text-sm text-accent">{pillar.sub}</div>
            <p class="mt-3 text-sm text-ink-2 leading-relaxed">{pillar.desc}</p>
            <ul class="mt-4 space-y-2 text-sm text-ink-2">
              {pillar.items.map((item) => (
                <li class="flex gap-2">
                  <span class="text-accent">✓</span>
                  {item}
                </li>
              ))}
            </ul>
          </Card>
        ))
      }
    </div>
  </Section>

  <Section width="wide">
    <SectionHeading
      eyebrow="ออกแบบมาเพื่อใคร"
      heading="บทบาทใน Solar Industry ที่ระบบคิดเงินตอบโจทย์ที่สุด"
    />
    <div class="mt-10 grid lg:grid-cols-2 gap-6">
      {
        personas.map((persona) => (
          <Card as="article">
            <h3 class="font-display font-bold text-lg text-ink">{persona.title}</h3>
            <p class="mt-3 text-sm text-ink-2 leading-relaxed">{persona.desc}</p>
            <ul class="mt-4 space-y-2 text-sm text-ink-2 list-disc list-inside">
              {persona.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </Card>
        ))
      }
    </div>
  </Section>

  <Section band="surface-y">
    <h2 class="font-display text-2xl font-bold text-ink text-center">
      ต่อยอดจากข้อมูลมิเตอร์ที่คุณมีอยู่แล้ว
    </h2>
    <p class="mt-3 text-center text-ink-2">
      ดึงข้อมูลอัตโนมัติจากระบบ{' '}
      <a href="/solutions/amr" class="text-accent font-semibold hover:text-accent-deep">AMR</a> ไม่ต้องกรอกตัวเลขมิเตอร์ซ้ำ
      — คำนวณและออกบิลจากข้อมูลจริงทุกรอบบิล
    </p>
  </Section>

  <Section id="quote" width="narrow">
    <h2 class="font-display text-2xl font-bold text-ink text-center">ขอใบเสนอราคา + ทดลอง Demo</h2>
    <p class="mt-2 text-center text-ink-2">
      ตอบกลับภายใน 1 วันทำการ · ทดลองใช้งานฟรี 30 วัน ไม่ต้องใช้บัตรเครดิต
    </p>

    <ContactForm subject="Billing — Quote request" formId="billing-quote" class="mt-8">
      <div class="grid sm:grid-cols-2 gap-5">
        <Field id="qf-name" name="name" label="ชื่อ-นามสกุล" required />
        <Field id="qf-company" name="company" label="บริษัท / โครงการ" />
      </div>
      <div class="grid sm:grid-cols-2 gap-5">
        <Field id="qf-email" name="email" label="อีเมล" type="email" required />
        <Field id="qf-phone" name="phone" label="เบอร์โทร" type="tel" />
      </div>
      <Field id="qf-type" name="business_type" label="ประเภทธุรกิจ" type="select">
        {businessTypes.map((type) => <option>{type}</option>)}
      </Field>
      <Field id="qf-rooms" name="portfolio_size" label="ขนาดพอร์ตโซลาร์ (โดยประมาณ)" type="select">
        {portfolioSizes.map((size) => <option>{size}</option>)}
      </Field>
      <Field id="qf-msg" name="message" label="ข้อความเพิ่มเติม" type="textarea" />
      <div class="flex items-start gap-2">
        <input id="qf-consent" name="consent" type="checkbox" required class="mt-1" />
        <label for="qf-consent" class="text-sm text-ink-2">
          ยินยอมให้ Advanced Grid ใช้ข้อมูลเพื่อติดต่อกลับ
        </label>
      </div>
    </ContactForm>
    <p class="mt-4 text-xs text-ink-3 text-center">ข้อมูลเก็บในประเทศไทย ปลอดภัยตาม PDPA</p>
  </Section>
</BaseLayout>
