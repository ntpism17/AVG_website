---
import AboutBody from '../components/pages/AboutBody.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSortedBrands } from '../lib/collections';
import { ABOUT_COPY } from '../lib/i18n/pages/about';

const brands = await getSortedBrands('th');
const t = ABOUT_COPY.th;
---

<BaseLayout title={t.metaTitle} description={t.metaDescription}>
  <AboutBody brands={brands} />
</BaseLayout>
