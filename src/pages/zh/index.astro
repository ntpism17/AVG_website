---
import HomeBody from '../../components/pages/HomeBody.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getFeaturedProducts, getSortedBrands } from '../../lib/collections';
import { HOME_COPY } from '../../lib/i18n/pages/home';

const products = await getFeaturedProducts('zh');
const brands = await getSortedBrands('zh');
const t = HOME_COPY.zh;
---

<BaseLayout title={t.metaTitle} exactTitle description={t.metaDescription}>
  <HomeBody {products} {brands} />
</BaseLayout>
