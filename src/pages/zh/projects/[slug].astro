---
import ProjectDetailBody from '../../../components/pages/ProjectDetailBody.astro';
import type { ProjectEntry } from '../../../content.config';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPublishedProjects } from '../../../lib/collections';
import { stripLocale } from '../../../lib/i18n/locales';
import { breadcrumbSchema } from '../../../lib/schema';

export async function getStaticPaths() {
  const projects = await getPublishedProjects('zh');
  return projects.map((project) => ({
    params: { slug: stripLocale(project.id) },
    props: { project },
  }));
}

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;

const breadcrumb = breadcrumbSchema(
  [{ name: '项目案例', href: '/projects' }, { name: project.data.title }],
  Astro.site,
  'zh'
);
---

<BaseLayout title={project.data.title} description={project.data.summary} ogType="article">
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(breadcrumb)} />
  <ProjectDetailBody project={project} />
</BaseLayout>
