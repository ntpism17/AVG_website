    </div>

    <div>
      <h5 class="font-display font-semibold text-ink mb-3">ผลิตภัณฑ์</h5>
      <ul class="space-y-2 text-sm text-ink-2">
        <li><a href="/products/prometer-100" class="hover:text-accent">CEWE Prometer 100</a></li>
        <li><a href="/products/premier-550" class="hover:text-accent">SECURE Premier 550</a></li>
        <li><a href="/products/proq-100" class="hover:text-accent">CEWE ProQ 100</a></li>
        <li><a href="/products/elite-500" class="hover:text-accent">CEWE Elite 500</a></li>
        <li><a href="/products/mk6e" class="hover:text-accent">EDMI Mk6E</a></li>
        <li><a href="/products/meter-calibration" class="hover:text-accent">บริการสอบเทียบมิเตอร์</a></li>
      </ul>
    </div>

    <div>
      <h5 class="font-display font-semibold text-ink mb-3">บริการ</h5>
      <ul class="space-y-2 text-sm text-ink-2">
        <li><a href="/services#consulting" class="hover:text-accent">ที่ปรึกษาทางวิศวกรรม</a></li>
        <li><a href="/services#design" class="hover:text-accent">ออกแบบและจัดหาอุปกรณ์</a></li>
        <li><a href="/services#installation" class="hover:text-accent">ติดตั้งและทดสอบ</a></li>
        <li><a href="/services#calibration" class="hover:text-accent">สอบเทียบและซ่อมบำรุง</a></li>
      </ul>
    </div>

    <div>
      <h5 class="font-display font-semibold text-ink mb-3">บริษัท</h5>
      <ul class="space-y-2 text-sm text-ink-2">
        <li><a href="/about" class="hover:text-accent">เกี่ยวกับเรา</a></li>
        <li><a href="/projects" class="hover:text-accent">โครงการของเรา</a></li>
        <li><a href="/contact" class="hover:text-accent">ติดต่อ</a></li>
        <li><a href="tel:+66992268000" class="hover:text-accent">099-226-8000</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="max-w-6xl mx-auto px-5 py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-ink-3">
      <div>&copy; {year} บริษัท แอดวานซ์ กริด จำกัด · สงวนลิขสิทธิ์</div>
      <div class="flex gap-4">
        <span>เลขทะเบียนนิติบุคคล 0125563021024</span>
      </div>
    </div>
  </div>
</footer>
