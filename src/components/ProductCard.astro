---
import { Image } from 'astro:assets';
import type { ProductEntry } from '../content.config';
import { stripLocale, type Locale } from '../lib/i18n/locales';
import { localeHref } from '../lib/i18n/url';
import Card from './ui/Card.astro';
import Pill from './ui/Pill.astro';

/**
 * Product summary card, shared by the products listing and the homepage teaser.
 * The listing shows spec pills and uses <h2>; the teaser omits them and uses <h3>.
 */
interface Props {
  product: ProductEntry;
  headingLevel?: 'h2' | 'h3';
  showSpecs?: boolean;
}

const { product, headingLevel: Heading = 'h2', showSpecs = false } = Astro.props;
const { name, brand, tagline, description, specs, image, imageAlt } = product.data;
const locale = (Astro.currentLocale ?? 'th') as Locale;
---

<Card href={localeHref(locale, `/products/${stripLocale(product.id)}`)} interactive>
  {
    image && (
      <Image
        src={image}
        alt={imageAlt ?? `${brand} ${name}`}
        width={640}
        height={480}
        class="mb-4 h-44 w-full rounded-lg border border-line bg-bg-elev object-contain p-3"
        loading="lazy"
      />
    )
  }
  <span class="font-en text-xs font-semibold text-accent">{brand}</span>
  <Heading class="mt-1 font-display font-semibold text-lg text-ink">{name}</Heading>
  <div class="text-sm text-ink-3">{tagline}</div>
  <p class="mt-2 text-sm text-ink-2 leading-relaxed">{description}</p>

  {
    showSpecs && (
      <div class="mt-4 flex flex-wrap gap-2">
        {specs.map((spec) => (
          <Pill>{spec}</Pill>
        ))}
      </div>
    )
  }
</Card>
