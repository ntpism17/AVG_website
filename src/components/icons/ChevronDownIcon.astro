---
interface Props {
  size?: number;
  class?: string;
}
const { size = 16, class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  <polyline points="6 9 12 15 18 9"></polyline>
</svg>
