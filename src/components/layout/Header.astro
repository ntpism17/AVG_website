---
import { Image } from 'astro:assets';
import wordmark from '../../assets/advancedgrid-wordmark.png';
import { type Locale } from '../../lib/i18n/locales';
import { localeHref } from '../../lib/i18n/url';
import { UI } from '../../lib/i18n/ui';
import { getMainNav } from '../../lib/nav';
import { SITE } from '../../lib/site';
import ChevronDownIcon from '../icons/ChevronDownIcon.astro';
import MailIcon from '../icons/MailIcon.astro';
import MenuIcon from '../icons/MenuIcon.astro';
import PhoneIcon from '../icons/PhoneIcon.astro';
import Button from '../ui/Button.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

const locale = (Astro.currentLocale ?? 'th') as Locale;
const mainNav = getMainNav(locale);
const ui = UI[locale];
---

<div class="utility bg-surface border-b border-line text-sm">
  <div class="max-w-6xl mx-auto px-5 flex items-center justify-between h-10">
    <div class="flex items-center gap-5 text-ink-2">
      <a
        href={SITE.phone.href}
        class="flex items-center gap-1.5 hover:text-accent"
        aria-label={`${ui.callLabel} ${SITE.phone.display}`}
      >
        <PhoneIcon />
        {SITE.phone.display}
      </a>
      <a
        href={`mailto:${SITE.email}`}
        class="hidden sm:flex items-center gap-1.5 hover:text-accent"
      >
        <MailIcon />
        {SITE.email}
      </a>
    </div>
    <LanguageSwitcher class="hidden sm:flex" />
  </div>
</div>

<header class="sticky top-0 z-40 bg-bg-elev/90 backdrop-blur border-b border-line relative">
  <div class="max-w-6xl mx-auto px-5 h-20 flex items-center justify-between gap-6">
    <a href={localeHref(locale, '/')} class="shrink-0" aria-label={`${SITE.name.en} home`}>
      <Image
        src={wordmark}
        alt={SITE.name.en}
        width={632}
        height={80}
        loading="eager"
        class="h-8 sm:h-10 w-auto object-contain"
      />
    </a>

    <nav class="hidden lg:flex items-center gap-6 font-en text-sm" aria-label="Main">
      {
        mainNav.map((item) =>
          item.children ? (
            <div class="relative group">
              <button
                type="button"
                class={
                  (item.accent
                    ? 'text-accent font-semibold hover:text-accent-deep'
                    : 'text-ink-2 hover:text-ink') + ' flex items-center gap-1'
                }
                aria-haspopup="true"
              >
                {item.label}
                <ChevronDownIcon class="transition-transform group-hover:rotate-180" />
              </button>
              <div class="absolute left-0 top-full hidden group-hover:block group-focus-within:block pt-2">
                <div class="min-w-48 rounded-md border border-line bg-bg-elev shadow-lg py-2">
                  {item.children.map((child) => (
                    <a
                      href={localeHref(locale, child.href)}
                      class="block px-4 py-2 text-ink-2 hover:bg-surface hover:text-ink"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={localeHref(locale, item.href!)}
              class={
                item.accent
                  ? 'text-accent font-semibold hover:text-accent-deep'
                  : 'text-ink-2 hover:text-ink'
              }
            >
              {item.label}
            </a>
          )
        )
      }
    </nav>

    <Button href={localeHref(locale, '/contact')} size="sm" class="max-lg:hidden">
      {ui.requestQuote}
    </Button>

    <details class="lg:hidden">
      <summary class="list-none cursor-pointer p-1" aria-label="Menu">
        <MenuIcon />
      </summary>
      <nav
        class="absolute inset-x-0 top-full flex flex-col gap-3 bg-bg-elev px-5 pb-4 pt-3 font-en text-sm border-t border-b border-line shadow-lg"
        aria-label="Main mobile"
      >
        {
          mainNav.map((item) =>
            item.children ? (
              <div>
                <span class={item.accent ? 'text-accent font-semibold' : 'text-ink-2'}>
                  {item.label}
                </span>
                <div class="mt-2 flex flex-col gap-2 pl-4">
                  {item.children.map((child) => (
                    <a href={localeHref(locale, child.href)} class="text-ink-2">
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              <a
                href={localeHref(locale, item.href!)}
                class={item.accent ? 'text-accent font-semibold' : 'text-ink-2'}
              >
                {item.label}
              </a>
            )
          )
        }
        <LanguageSwitcher class="mt-2 pt-3 border-t border-line sm:hidden" />
      </nav>
    </details>
  </div>
</header>
