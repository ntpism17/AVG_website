---
import { stripLocale } from '../../lib/i18n/locales';
import type { ArticleEntry } from '../../content.config';
import { type Locale } from '../../lib/i18n/locales';
import { localeHref } from '../../lib/i18n/url';
import { INSIGHTS_INDEX_COPY } from '../../lib/i18n/pages/insights-index';
import { SEGMENTS } from '../../lib/segments';
import Card from '../ui/Card.astro';
import Pill from '../ui/Pill.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  articles: ArticleEntry[];
}

const { articles } = Astro.props;
const locale = (Astro.currentLocale ?? 'th') as Locale;
const t = INSIGHTS_INDEX_COPY[locale];

function segmentLabel(id: string): string {
  return SEGMENTS.find((s) => s.id === id)?.[locale] ?? t.generalLabel;
}
---

<Section width="wide" spacing="lg">
  <SectionHeading as="h1" eyebrow={t.eyebrow} heading={t.heading} lede={t.lede} />

  <div class="mt-10 grid sm:grid-cols-2 gap-6">
    {
      articles.map((article) =>
        article.data.status === 'published' ? (
          <Card href={localeHref(locale, `/insights/${stripLocale(article.id)}`)} interactive>
            <Pill size="sm">{segmentLabel(article.data.segment)}</Pill>
            <h2 class="mt-3 font-display font-semibold text-lg text-ink">{article.data.title}</h2>
            <p class="mt-2 text-sm text-ink-2 leading-relaxed">{article.data.metaDescription}</p>
            <span class="mt-4 inline-block text-sm font-semibold text-accent">{t.readMore}</span>
          </Card>
        ) : (
          <div class="rounded-lg border border-dashed border-line-strong bg-surface p-6 opacity-70">
            <Pill size="sm">{segmentLabel(article.data.segment)}</Pill>
            <h2 class="mt-3 font-display font-semibold text-lg text-ink">{article.data.title}</h2>
            <p class="mt-3 text-sm text-ink-3">{t.pendingLabel}</p>
          </div>
        )
      )
    }
  </div>
</Section>
