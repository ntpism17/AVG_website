---
import ContactForm from '../ContactForm.astro';
import chowEnergyLogo from '../../assets/customers/chow-energy.jpeg';
import mahidolUniversityLogo from '../../assets/customers/mahidol-university.png';
import { AMR_COPY } from '../../lib/i18n/pages/solutions-amr';
import { type Locale } from '../../lib/i18n/locales';
import { localeHref } from '../../lib/i18n/url';
import { UI } from '../../lib/i18n/ui';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Field from '../ui/Field.astro';
import LogoWall from '../ui/LogoWall.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const locale = (Astro.currentLocale ?? 'th') as Locale;
const t = AMR_COPY[locale];
const ui = UI[locale];

const inverterIntegrations = ['Huawei FusionSolar', 'SMA', 'Sungrow', 'SolarEdge'];
const meterIntegrations = ['Mk6E', 'Premier 550', 'Elite 500'];

// Customers running our AMR system, supplied directly by the client.
const amrCustomers = [
  { name: 'Chow Energy', src: chowEnergyLogo },
  { name: 'Mahidol University', src: mahidolUniversityLogo },
];
---

<Section width="wide" spacing="lg">
  <Eyebrow>{t.heroEyebrow}</Eyebrow>
  <h1 class="mt-3 font-display text-4xl sm:text-5xl font-bold leading-tight text-ink">
    {t.heroHeading}
  </h1>
  <p class="mt-5 text-lg text-ink-2 leading-relaxed max-w-3xl">
    {t.heroLedePrefix}
    <a
      href={localeHref(locale, '/solutions/billing')}
      class="text-accent font-semibold hover:text-accent-deep">{t.billingLinkText}</a
    >{t.heroLedeSuffix}
  </p>
  <div class="mt-8 flex flex-wrap gap-4">
    <Button href="#quote">{t.heroCtaDemo}</Button>
    <Button href="#quote" variant="secondary">{t.heroCtaConsult}</Button>
  </div>
</Section>

<Section band="surface-y" width="wide">
  <SectionHeading eyebrow={t.pillarsEyebrow} heading={t.pillarsHeading} />
  <div class="mt-10 grid lg:grid-cols-3 gap-6">
    {
      t.pillars.map((pillar) => (
        <Card as="article" id={pillar.id}>
          <h3 class="font-display font-bold text-lg text-ink">{pillar.title}</h3>
          <div class="font-en text-sm text-accent">{pillar.sub}</div>
          <p class="mt-3 text-sm text-ink-2 leading-relaxed">{pillar.desc}</p>
          <ul class="mt-4 space-y-2 text-sm text-ink-2">
            {pillar.items.map((item) => (
              <li class="flex gap-2">
                <span class="text-accent">✓</span>
                {item}
              </li>
            ))}
          </ul>
        </Card>
      ))
    }
  </div>
</Section>

<Section width="wide">
  <SectionHeading eyebrow={t.workflowEyebrow} heading={t.workflowHeading} lede={t.workflowLede} />
  <ol class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {
      t.workflow.map((step, i) => (
        <li>
          <Card class="h-full">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-accent font-display font-bold text-white">
              {i + 1}
            </div>
            <h3 class="mt-4 font-display font-bold text-ink">{step.title}</h3>
            <p class="mt-2 text-sm text-ink-2 leading-relaxed">{step.desc}</p>
          </Card>
        </li>
      ))
    }
  </ol>
  <div class="mt-8 grid lg:grid-cols-2 gap-6">
    <Card tone="surface">
      <h3 class="font-display font-bold text-lg text-ink">{t.failureHeading}</h3>
      <ul class="mt-4 space-y-2 text-sm text-ink-2">
        {
          t.failureItems.map((item) => (
            <li class="flex gap-2">
              <span class="text-accent">✓</span>
              {item}
            </li>
          ))
        }
      </ul>
    </Card>
    <Card tone="surface">
      <p class="text-sm text-ink-2 leading-relaxed">{t.roleNote}</p>
      <a
        href={localeHref(locale, '/solutions/billing')}
        class="mt-4 inline-block text-sm font-semibold text-accent hover:text-accent-deep"
        >{t.roleNoteLinkText}</a
      >
    </Card>
  </div>
</Section>

<Section band="surface-y" width="wide">
  <SectionHeading eyebrow={t.personasEyebrow} heading={t.personasHeading} />
  <div class="mt-10 grid lg:grid-cols-2 gap-6">
    {
      t.personas.map((persona) => (
        <Card as="article">
          <h3 class="font-display font-bold text-lg text-ink">{persona.title}</h3>
          <p class="mt-3 text-sm text-ink-2 leading-relaxed">{persona.desc}</p>
          <ul class="mt-4 space-y-2 text-sm text-ink-2 list-disc list-inside">
            {persona.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </Card>
      ))
    }
  </div>
</Section>

<Section>
  <h2 class="font-display text-2xl font-bold text-ink text-center">{t.integrationsHeading}</h2>
  <p class="mt-3 text-center text-ink-2">
    {t.integrationsLedePrefix}{inverterIntegrations.join(', ')}{t.integrationsLedeMid}{
      meterIntegrations.join(', ')
    }{t.integrationsLedeSuffix}
  </p>
  <div
    class="mt-6 flex flex-wrap justify-center gap-x-8 gap-y-2 font-display font-semibold text-ink-2"
  >
    {inverterIntegrations.map((name) => <span>{name}</span>)}
    {meterIntegrations.map((name) => <span>{name}</span>)}
  </div>
</Section>

<Section band="surface-y" width="narrow">
  <h2 class="font-display text-2xl font-bold text-ink text-center">{t.customersHeading}</h2>
  <LogoWall logos={amrCustomers} columns={2} class="mt-8" />
</Section>

<Section id="quote" width="narrow">
  <h2 class="font-display text-2xl font-bold text-ink text-center">{t.quoteHeading}</h2>
  <p class="mt-2 text-center text-ink-2">{t.quoteLede}</p>

  <ContactForm subject="AMR — Quote request" formId="amr-quote" class="mt-8">
    <div class="grid sm:grid-cols-2 gap-5">
      <Field id="qf-name" name="name" label={ui.form.name} required />
      <Field id="qf-company" name="company" label={ui.form.companyOrProject} />
    </div>
    <div class="grid sm:grid-cols-2 gap-5">
      <Field id="qf-email" name="email" label={ui.form.email} type="email" required />
      <Field id="qf-phone" name="phone" label={ui.form.phone} type="tel" />
    </div>
    <Field id="qf-type" name="business_type" label={ui.form.businessType} type="select">
      {t.businessTypes.map((type) => <option>{type}</option>)}
    </Field>
    <Field id="qf-rooms" name="portfolio_size" label={ui.form.portfolioSize} type="select">
      {t.portfolioSizes.map((size) => <option>{size}</option>)}
    </Field>
    <Field id="qf-msg" name="message" label={ui.form.message} type="textarea" />
    <div class="flex items-start gap-2">
      <input id="qf-consent" name="consent" type="checkbox" required class="mt-1" />
      <label for="qf-consent" class="text-sm text-ink-2">
        {ui.form.consent}
      </label>
    </div>
  </ContactForm>
  <p class="mt-4 text-xs text-ink-3 text-center">{ui.form.pdpaNotice}</p>
</Section>
