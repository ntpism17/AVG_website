---
import { Image } from 'astro:assets';
import type { BrandEntry } from '../../content.config';
import solarImage from '../../assets/pexels-michael-pointner-134459625-18306344.jpg';
import CheckIcon from '../icons/CheckIcon.astro';
import { type Locale } from '../../lib/i18n/locales';
import { localeHref } from '../../lib/i18n/url';
import { ABOUT_COPY } from '../../lib/i18n/pages/about';
import { legalName } from '../../lib/site';
import Card from '../ui/Card.astro';
import CTABand from '../ui/CTABand.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  brands: BrandEntry[];
}

const { brands } = Astro.props;
const locale = (Astro.currentLocale ?? 'th') as Locale;
const t = ABOUT_COPY[locale];

// Placeholder sentinel used by the brands collection for unconfirmed fields.
const PENDING = '[pending]';
---

<Section spacing="lg" width="wide">
  <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-12 items-center">
    <div>
      <Eyebrow>{t.heroEyebrow}</Eyebrow>
      <h1 class="mt-3 font-display text-4xl sm:text-5xl font-bold text-ink">{t.heroHeading}</h1>
      <p class="mt-6 text-lg text-ink-2 leading-relaxed">{t.heroParagraph1(legalName(locale))}</p>
      <p class="mt-4 text-lg text-ink-2 leading-relaxed">{t.heroParagraph2}</p>
      <a
        href={localeHref(locale, '/services')}
        class="mt-6 inline-block font-semibold text-accent hover:text-accent-deep"
      >
        {t.heroSecondaryCta}
      </a>
    </div>
    <Image
      src={solarImage}
      alt={t.heroImageAlt}
      widths={[400, 800, 1200]}
      sizes="(min-width: 1024px) 40vw, 90vw"
      class="w-full h-72 sm:h-96 lg:h-[28rem] rounded-2xl border border-line object-cover"
      loading="eager"
    />
  </div>
</Section>

<Section band="surface-y" spacing="sm">
  <h2 class="font-display text-2xl font-bold text-ink">{t.principlesHeading}</h2>
  <p class="mt-3 text-ink-2">{t.principlesLede}</p>
  <div class="mt-8 grid sm:grid-cols-2 gap-6">
    {
      t.principles.map((principle) => (
        <Card class="flex gap-4">
          <span class="flex-none flex h-9 w-9 items-center justify-center rounded-full bg-accent/10 text-accent">
            <CheckIcon class="h-5 w-5" />
          </span>
          <div>
            <h3 class="font-display font-semibold text-ink">{principle.title}</h3>
            <p class="mt-2 text-sm text-ink-2">{principle.desc}</p>
          </div>
        </Card>
      ))
    }
  </div>
</Section>

<Section spacing="sm">
  <SectionHeading eyebrow={t.brandsEyebrow} heading={t.brandsHeading} lede={t.brandsLede} />
  <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      brands.map((brand) => (
        <Card as="article">
          {brand.data.logo ? (
            <Image
              src={brand.data.logo}
              alt={brand.data.logoAlt ?? brand.data.name}
              height={40}
              class="h-10 w-auto object-contain"
              loading="lazy"
            />
          ) : (
            <div class="flex h-10 items-center font-display text-xl font-bold text-ink-3">
              {brand.data.name}
            </div>
          )}
          <h3 class="mt-4 font-display font-bold text-xl text-ink">{brand.data.name}</h3>
          {brand.data.origin !== PENDING && <p class="text-sm text-ink-3">{brand.data.origin}</p>}
          <p class="mt-3 text-sm text-ink-2 leading-relaxed">{brand.data.description}</p>
          <div class="mt-4 flex gap-6 text-sm border-t border-line pt-4">
            {brand.data.founded !== PENDING && (
              <div>
                <strong class="block text-ink">{t.foundedLabel}</strong>
                <span class="text-ink-2">{brand.data.founded}</span>
              </div>
            )}
            <div>
              <strong class="block text-ink">{brand.data.highlightLabel}</strong>
              <span class="text-ink-2">{brand.data.highlightValue}</span>
            </div>
          </div>
        </Card>
      ))
    }
  </div>
</Section>

<CTABand heading={t.ctaHeading} ctaLabel={t.ctaLabel} />
