---
import { Image } from 'astro:assets';
import ContactForm from '../ContactForm.astro';
import frasersPropertyLogo from '../../assets/customers/frasers-property.png';
import oneBangkokLogo from '../../assets/customers/onebkk.png';
import CheckIcon from '../icons/CheckIcon.astro';
import { type Locale } from '../../lib/i18n/locales';
import { BILLING_COPY } from '../../lib/i18n/pages/solutions-billing';
import { UI } from '../../lib/i18n/ui';
import { localeHref } from '../../lib/i18n/url';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Field from '../ui/Field.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const locale = (Astro.currentLocale ?? 'th') as Locale;
const t = BILLING_COPY[locale];
const ui = UI[locale];

// Customers running our billing system, supplied directly by the client.
const billingCustomers = [
  { name: 'One Bangkok', logo: oneBangkokLogo },
  { name: 'Frasers Property', logo: frasersPropertyLogo },
];
---

<!-- 1. Hero — audience + what the system handles -->
<Section width="wide" spacing="lg">
  <Eyebrow>{t.eyebrow}</Eyebrow>
  <h1 class="mt-3 font-display text-4xl sm:text-5xl font-bold leading-tight text-ink">
    {t.heroHeading}
  </h1>
  <p class="mt-5 text-lg text-ink-2 leading-relaxed max-w-3xl">
    {t.heroSub}
  </p>
  <p class="mt-3 text-sm font-semibold text-ink-3">{t.heroAudience}</p>
  <div class="mt-8 flex flex-wrap gap-4">
    <Button href="#quote">{t.ctaDemo}</Button>
    <Button href="#quote" variant="secondary">{t.ctaConsult}</Button>
  </div>
</Section>

<!-- 2. Problems the audience faces -->
<Section band="surface-y" width="default">
  <SectionHeading eyebrow={t.painsEyebrow} heading={t.painsHeading} lede={t.painsLede} />
  <div class="mt-8 overflow-x-auto rounded-lg border border-line bg-bg-elev">
    <table class="w-full min-w-[560px] border-collapse text-sm">
      <thead>
        <tr class="border-b border-line bg-surface text-left">
          <th scope="col" class="w-1/2 py-3 px-4 font-display font-bold text-ink"
            >{t.painsProblemLabel}</th
          >
          <th scope="col" class="w-1/2 py-3 px-4 font-display font-bold text-ink"
            >{t.painsImpactLabel}</th
          >
        </tr>
      </thead>
      <tbody>
        {
          t.pains.map((row) => (
            <tr class="border-b border-line last:border-b-0 align-top">
              <td class="py-3 px-4 text-ink-2">{row.problem}</td>
              <td class="py-3 px-4 text-ink-2">{row.impact}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Section>

<!-- 3. Workflow -->
<Section width="wide">
  <SectionHeading eyebrow={t.workflowEyebrow} heading={t.workflowHeading} lede={t.workflowLede} />
  <ol class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {
      t.workflow.map((step, i) => (
        <li>
          <Card class="h-full">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-accent font-display font-bold text-white">
              {i + 1}
            </div>
            <h3 class="mt-4 font-display font-bold text-ink">{step.title}</h3>
            <p class="mt-2 text-sm text-ink-2 leading-relaxed">{step.desc}</p>
          </Card>
        </li>
      ))
    }
  </ol>
</Section>

<!-- 4. Capabilities, each with its scope -->
<Section band="surface-y" width="wide">
  <SectionHeading eyebrow={t.featuresEyebrow} heading={t.featuresHeading} />
  <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      t.features.map((feature) => (
        <Card as="article" id={feature.id}>
          <h3 class="font-display font-bold text-lg text-ink">{feature.title}</h3>
          <p class="mt-2 text-sm text-ink-2 leading-relaxed">{feature.desc}</p>
          <p class="mt-3 border-t border-line pt-3 text-xs text-ink-3 leading-relaxed">
            <span class="font-semibold text-ink-2">{t.featuresScopeLabel}:</span>
            {feature.scope}
          </p>
        </Card>
      ))
    }
  </div>
  <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {
      t.highlights.map((item) => (
        <div class="rounded-lg border border-line bg-bg-elev p-4">
          <h3 class="font-display font-bold text-sm text-ink">{item.title}</h3>
          <p class="mt-1 text-sm text-ink-2 leading-relaxed">{item.desc}</p>
        </div>
      ))
    }
  </div>
</Section>

<!-- 5. Sample screenshots — TODO(AVG): add once AVG approves masked system/invoice images. -->

<!-- 6. Connecting and getting started -->
<Section width="wide">
  <SectionHeading eyebrow={t.startEyebrow} heading={t.startHeading} lede={t.startLede} />
  <div class="mt-10 grid lg:grid-cols-2 gap-6">
    <Card>
      <h3 class="font-display font-bold text-lg text-ink">{t.prepareHeading}</h3>
      <ul class="mt-4 space-y-3">
        {
          t.prepareItems.map((item) => (
            <li class="flex gap-2 text-sm text-ink-2 leading-relaxed">
              <CheckIcon class="mt-0.5 h-4 w-4 flex-none text-accent" />
              {item}
            </li>
          ))
        }
      </ul>
    </Card>
    <Card>
      <h3 class="font-display font-bold text-lg text-ink">{t.onboardingHeading}</h3>
      <ol class="mt-4 space-y-4">
        {
          t.onboarding.map((step, i) => (
            <li class="flex gap-3">
              <span class="flex h-7 w-7 flex-none items-center justify-center rounded-full bg-accent text-sm font-bold text-white">
                {i + 1}
              </span>
              <div>
                <p class="font-semibold text-ink">{step.title}</p>
                <p class="mt-1 text-sm text-ink-2 leading-relaxed">{step.desc}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </Card>
  </div>
  <p class="mt-6 text-sm text-ink-2">
    {t.supportedMetersNote}{' '}
    <a href={localeHref(locale, '/solutions/amr')} class="font-semibold text-accent hover:underline"
      >{t.amrLinkText}</a
    >
  </p>
</Section>

<!-- 7. Evidence -->
<Section band="surface-y" width="narrow">
  <h2 class="font-display text-2xl font-bold text-ink text-center">{t.customersHeading}</h2>
  <div class="mt-8 grid grid-cols-2 gap-4">
    {
      billingCustomers.map((customer) => (
        <div class="flex items-center justify-center rounded-lg border border-line bg-bg-elev p-4 h-28">
          <Image
            src={customer.logo}
            alt={customer.name}
            widths={[200, 400]}
            sizes="(min-width: 640px) 40vw, 50vw"
            class="max-h-16 w-auto max-w-full object-contain"
            loading="lazy"
          />
        </div>
      ))
    }
  </div>
</Section>

<!-- 8. FAQ — mirrored into FAQPage JSON-LD by the route file -->
<Section width="default">
  <SectionHeading eyebrow={t.faqEyebrow} heading={t.faqHeading} />
  <div class="mt-8 space-y-6">
    {
      t.faq.map((entry) => (
        <div>
          <h3 class="font-display font-semibold text-ink">{entry.question}</h3>
          <p class="mt-2 text-sm text-ink-2 leading-relaxed">{entry.answer}</p>
        </div>
      ))
    }
  </div>
</Section>

<!-- 9. Next step + form -->
<Section id="quote" band="surface-top" width="narrow">
  <h2 class="font-display text-2xl font-bold text-ink text-center">{t.quoteHeading}</h2>
  <p class="mt-2 text-center text-ink-2">{t.quoteLede}</p>
  <p class="mt-2 text-center text-sm text-ink-3">{t.quoteNextStep}</p>

  <ContactForm subject="Billing — Quote request" formId="billing-quote" class="mt-8">
    <div class="grid sm:grid-cols-2 gap-5">
      <Field id="qf-name" name="name" label={ui.form.name} required />
      <Field id="qf-company" name="company" label={ui.form.companyOrProject} />
    </div>
    <div class="grid sm:grid-cols-2 gap-5">
      <Field id="qf-email" name="email" label={ui.form.email} type="email" required />
      <Field id="qf-phone" name="phone" label={ui.form.phone} type="tel" />
    </div>
    <Field id="qf-type" name="business_type" label={ui.form.businessType} type="select">
      {t.businessTypes.map((type) => <option>{type}</option>)}
    </Field>
    <Field id="qf-rooms" name="portfolio_size" label={ui.form.portfolioSize} type="select">
      {t.portfolioSizes.map((size) => <option>{size}</option>)}
    </Field>
    <Field id="qf-msg" name="message" label={ui.form.message} type="textarea" />
    <div class="flex items-start gap-2">
      <input id="qf-consent" name="consent" type="checkbox" required class="mt-1" />
      <label for="qf-consent" class="text-sm text-ink-2">
        {ui.form.consent}
      </label>
    </div>
  </ContactForm>
  <p class="mt-4 text-xs text-ink-3 text-center">{ui.form.pdpaNotice}</p>
</Section>
