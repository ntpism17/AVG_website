---
import CheckIcon from '../icons/CheckIcon.astro';
import Button from '../ui/Button.astro';
import { type Locale } from '../../lib/i18n/locales';
import { localeHref } from '../../lib/i18n/url';
import { CONTACT_THANK_YOU_COPY } from '../../lib/i18n/pages/contact-thank-you';
import { SITE } from '../../lib/site';

const locale = (Astro.currentLocale ?? 'th') as Locale;
const t = CONTACT_THANK_YOU_COPY[locale];
---

<div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-accent-soft">
  <CheckIcon class="h-8 w-8 text-accent" label={t.checkIconLabel} />
</div>

<h1 class="mt-8 font-display text-3xl sm:text-4xl font-bold text-ink">{t.heading}</h1>
<p class="mt-4 text-lg text-ink-2 leading-relaxed">{t.lede}</p>

<div class="mt-10 rounded-lg border border-line bg-surface p-6 text-left">
  <h2 class="font-display font-semibold text-ink">{t.urgentHeading}</h2>
  <dl class="mt-4 space-y-2 text-sm">
    <div class="flex gap-2">
      <dt class="font-medium text-ink">{t.phoneLabel}</dt>
      <dd>
        <a href={SITE.phone.href} class="font-semibold text-accent hover:text-accent-deep">
          {SITE.phone.display}
        </a>
      </dd>
    </div>
    <div class="flex gap-2">
      <dt class="font-medium text-ink">{t.emailLabel}</dt>
      <dd>
        <a href={`mailto:${SITE.email}`} class="font-semibold text-accent hover:text-accent-deep">
          {SITE.email}
        </a>
      </dd>
    </div>
  </dl>
</div>

<div class="mt-10 flex flex-wrap justify-center gap-4">
  <Button href={localeHref(locale, '/')}>{t.backHome}</Button>
  <Button href={localeHref(locale, '/products')} variant="secondary">{t.viewAllProducts}</Button>
</div>
