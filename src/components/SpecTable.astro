---
/**
 * Grouped datasheet specifications.
 *
 * Values are transcribed verbatim from manufacturer datasheets (see CLAUDE.md),
 * so `source` is rendered alongside them to keep every claim traceable.
 */
interface Props {
  heading: string;
  groups: readonly { group: string; rows: readonly { label: string; value: string }[] }[];
  source?: string;
  sourceLabel?: string;
  class?: string;
}

const { heading, groups, source, sourceLabel = 'ที่มา', class: className } = Astro.props;
---

<section class:list={['mt-14', className]}>
  <h2 class="font-display text-2xl font-bold text-ink">{heading}</h2>
  {
    source && (
      <p class="mt-1 text-xs text-ink-3">
        {sourceLabel}: {source}
      </p>
    )
  }

  <div class="mt-5 space-y-8">
    {
      groups.map((group) => (
        <div>
          <h3 class="font-display font-semibold text-ink">{group.group}</h3>
          <div class="mt-3 overflow-x-auto">
            <table class="w-full border-collapse text-sm">
              <tbody>
                {group.rows.map((row) => (
                  <tr class="border-b border-line align-top">
                    <th scope="row" class="w-2/5 py-2.5 pr-4 text-left font-medium text-ink">
                      {row.label}
                    </th>
                    <td class="py-2.5 text-ink-2">{row.value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))
    }
  </div>
</section>
