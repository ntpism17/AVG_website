---
<svg viewBox="0 0 560 560" class="w-full h-full" role="img" aria-label="ภาพประกอบมิเตอร์ไฟฟ้าอัจฉริยะเชื่อมต่อกับระบบไฟฟ้า">
  <defs>
    <linearGradient id="bgGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="var(--surface)"/>
      <stop offset="100%" stop-color="var(--bg-elev)"/>
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M40 0L0 0 0 40" fill="none" stroke="var(--line)" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="560" height="560" rx="28" fill="url(#bgGrad)" stroke="var(--line)"/>
  <rect width="560" height="560" rx="28" fill="url(#grid)" opacity="0.6"/>

  <g stroke="var(--ink-3)" stroke-width="1.2" opacity="0.35" fill="none">
    <path d="M0 380 Q140 360 280 370 T560 380"/>
    <path d="M0 410 Q140 390 280 400 T560 410"/>
    <path d="M0 440 Q140 420 280 430 T560 440"/>
  </g>

  <g stroke="var(--ink-2)" stroke-width="1.5" fill="none">
    <g transform="translate(80, 320)">
      <line x1="20" y1="0" x2="20" y2="120"/>
      <path d="M0 30 L40 30 M5 50 L35 50 M10 70 L30 70"/>
      <path d="M0 30 L20 0 L40 30"/>
    </g>
    <g transform="translate(440, 320)">
      <line x1="20" y1="0" x2="20" y2="120"/>
      <path d="M0 30 L40 30 M5 50 L35 50 M10 70 L30 70"/>
      <path d="M0 30 L20 0 L40 30"/>
    </g>
  </g>

  <g transform="translate(180, 130)">
    <rect width="200" height="280" rx="14" fill="var(--bg-elev)" stroke="var(--ink-2)" stroke-width="1.5"/>
    <rect x="20" y="20" width="160" height="18" rx="2" fill="var(--ink)"/>
    <text x="100" y="33" font-family="Manrope" font-size="10" font-weight="600" fill="var(--accent)" text-anchor="middle" letter-spacing="2">ADVANCED GRID</text>
    <rect x="20" y="50" width="160" height="90" rx="6" fill="var(--ink)"/>
    <text x="170" y="78" font-family="Manrope" font-size="32" font-weight="700" fill="#F59E0B" text-anchor="end">87,432</text>
    <text x="170" y="92" font-family="Inter" font-size="9" fill="#94A3B8" text-anchor="end">kWh · Total Active Energy</text>
    <g transform="translate(30, 110)">
      <rect width="50" height="20" rx="3" fill="rgba(245,158,11,0.15)"/>
      <text x="25" y="13" font-family="Inter" font-size="8" font-weight="600" fill="#F59E0B" text-anchor="middle">TOU · ON</text>
      <rect x="58" width="50" height="20" rx="3" fill="rgba(34,197,94,0.15)"/>
      <text x="83" y="13" font-family="Inter" font-size="8" font-weight="600" fill="#22C55E" text-anchor="middle">PF 0.98</text>
      <rect x="116" width="34" height="20" rx="3" fill="rgba(148,163,184,0.15)"/>
      <text x="133" y="13" font-family="Inter" font-size="8" font-weight="600" fill="#94A3B8" text-anchor="middle">50 Hz</text>
    </g>
    <g transform="translate(20, 160)">
      <circle cx="20" cy="20" r="14" fill="var(--surface)" stroke="var(--line)"/>
      <circle cx="60" cy="20" r="14" fill="var(--surface)" stroke="var(--line)"/>
      <circle cx="100" cy="20" r="14" fill="var(--surface)" stroke="var(--line)"/>
      <circle cx="140" cy="20" r="14" fill="var(--accent)"/>
    </g>
    <rect x="20" y="200" width="160" height="60" rx="4" fill="var(--surface)" stroke="var(--line)"/>
    <g transform="translate(30, 215)" fill="var(--ink-3)">
      <rect width="14" height="30" rx="2"/>
      <rect x="22" width="14" height="30" rx="2"/>
      <rect x="44" width="14" height="30" rx="2"/>
      <rect x="66" width="14" height="30" rx="2"/>
      <rect x="88" width="14" height="30" rx="2"/>
      <rect x="110" width="14" height="30" rx="2"/>
      <rect x="132" width="14" height="30" rx="2"/>
    </g>
  </g>

  <g stroke="var(--accent)" stroke-width="1.5" fill="none" opacity="0.4">
    <path d="M380 200 Q420 200 440 230"/>
    <path d="M390 180 Q450 180 480 230" opacity="0.6"/>
    <path d="M400 160 Q480 160 520 230" opacity="0.3"/>
  </g>
  <circle cx="500" cy="180" r="4" fill="var(--accent)"/>

  <g transform="translate(70, 480)" opacity="0.6">
    <g fill="var(--ink-2)" stroke="var(--ink)" stroke-width="0.5">
      <polygon points="0,30 50,30 60,0 10,0"/>
      <polygon points="60,30 110,30 120,0 70,0"/>
      <polygon points="120,30 170,30 180,0 130,0"/>
    </g>
  </g>
  <g transform="translate(330, 480)" opacity="0.6">
    <g fill="var(--ink-2)" stroke="var(--ink)" stroke-width="0.5">
      <polygon points="0,30 50,30 60,0 10,0"/>
      <polygon points="60,30 110,30 120,0 70,0"/>
      <polygon points="120,30 170,30 180,0 130,0"/>
    </g>
  </g>
</svg>
