---
import { Image } from 'astro:assets';
import wordmark from '../assets/advancedgrid-wordmark.png';

const navItems = [
  { href: '/about', th: 'เกี่ยวกับเรา', en: 'About' },
  { href: '/services', th: 'บริการ', en: 'Services' },
  { href: '/products', th: 'ผลิตภัณฑ์', en: 'Products' },
  { href: '/solutions/solar-smart-bill', th: 'Solar Smart Bill', en: 'Solar Smart Bill', accent: true },
  { href: '/projects', th: 'โครงการ', en: 'Projects' },
  { href: '/contact', th: 'ติดต่อ', en: 'Contact' },
];
---

<div class="utility bg-surface border-b border-line text-sm">
  <div class="max-w-6xl mx-auto px-5 flex items-center justify-between h-10">
    <div class="flex items-center gap-5 text-ink-2">
      <a href="tel:+66992268000" class="flex items-center gap-1.5 hover:text-accent" aria-label="โทร 099-226-8000">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
        099-226-8000
      </a>
      <a href="mailto:advancedgrid@gmail.com" class="hidden sm:flex items-center gap-1.5 hover:text-accent">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        advancedgrid@gmail.com
      </a>
      <a href="https://line.me/ti/p/~856khvjl" class="hidden md:flex items-center gap-1.5 hover:text-accent">
        LINE: @856khvjl
      </a>
    </div>
  </div>
</div>

<header class="sticky top-0 z-40 bg-bg-elev/90 backdrop-blur border-b border-line relative">
  <div class="max-w-6xl mx-auto px-5 h-20 flex items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label="Advanced Grid home">
      <Image src={wordmark} alt="Advanced Grid" width={160} height={40} loading="eager" style="object-fit: contain; height: 40px; width: auto;" />
    </a>

    <nav class="hidden lg:flex items-center gap-6 font-en text-sm" aria-label="Main">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={item.accent ? 'text-accent font-semibold hover:text-accent-deep' : 'text-ink-2 hover:text-ink'}
        >
          {item.th}
        </a>
      ))}
    </nav>

    <a
      href="/contact"
      class="hidden lg:inline-flex items-center rounded-md bg-accent px-4 py-2 text-sm font-semibold text-white hover:bg-accent-deep transition-colors"
    >
      ขอใบเสนอราคา
    </a>

    <details class="lg:hidden">
      <summary class="list-none cursor-pointer p-1" aria-label="Menu">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </summary>
      <nav class="absolute inset-x-0 top-full flex flex-col gap-3 bg-bg-elev px-5 pb-4 pt-3 font-en text-sm border-t border-b border-line shadow-lg" aria-label="Main mobile">
        {navItems.map((item) => (
          <a href={item.href} class={item.accent ? 'text-accent font-semibold' : 'text-ink-2'}>{item.th}</a>
        ))}
      </nav>
    </details>
  </div>
</header>
